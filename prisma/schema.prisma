generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. PLANO DE PLATAFORMA SAAS (NANOLABS CORE)
// ==========================================

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  status      String   @default("ACTIVE")
  email       String?
  phone       String?
  address     String?
  city        String?
  cuit        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domains       TenantDomain[]
  subscription  Subscription?
  locations     Location[]
  memberships   TenantMembership[]
  features      TenantFeature[]
  settings      TenantSettings?
  auditLogs     PlatformAuditLog[]
  saasPayments  SaaSPayment[]
  vehiculos     Vehiculo[]
  clientes      Cliente[]
  ventas        Venta[]
  ventaCuotas   VentaCuota[]
  prestamos     Prestamo[]
  prestamoCuotas PrestamoCuota[]
  tareas        Tarea[]
  gastos        Gasto[]
  senias        Senia[]
  anotaciones   Anotacion[]
  fotos         VehiculoFoto[]
  prospectos    Prospecto[]
  cotizaciones  Cotizacion[]
  entregas      Entrega[]
  cashSessions  CashSession[]
  cashMovements CashMovement[]

  @@index([status])
  @@index([createdAt])
}

model TenantDomain {
  id         String    @id @default(uuid())
  tenantId   String
  hostname   String    @unique
  isPrimary  Boolean   @default(false)
  isCustom   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?  @db.Text
  priceMonthly Float    @default(0)
  maxVehicles  Int      @default(50)
  maxLocations Int      @default(1)
  maxUsers     Int      @default(5)
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  planId             String
  status             String    @default("ACTIVE")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan          @relation(fields: [planId], references: [id])
  payments SaaSPayment[]

  @@index([status])
}

model SaaSPayment {
  id             String    @id @default(uuid())
  tenantId       String
  subscriptionId String
  amount         Float
  currency       String    @default("USD")
  status         String    @default("PAID")
  method         String?
  reference      String?
  notes          String?
  paidAt         DateTime?
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([subscriptionId])
}

model TenantFeature {
  id         String   @id @default(uuid())
  tenantId   String
  featureKey String
  isEnabled  Boolean  @default(true)
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}

model TenantSettings {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  appName              String   @default("OnlyCars")
  logoUrl              String?
  primaryColor         String   @default("#2563eb")
  secondaryColor       String   @default("#0f172a")
  dolarActual          Float    @default(1400)
  tipoDolar            String   @default("blue")
  tnaFinanciacion      Float    @default(48.0)
  comisionVentaDefecto Float    @default(3.0)
  telefonoContacto     String?
  emailContacto        String?
  whatsappLead         String?
  cuit                 String?
  razonSocial          String?
  direccion            String?
  pieImpresion         String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PlatformAuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action])
}

// ==========================================
// 2. USUARIOS, SESIONES Y ROLES
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  TenantMembership[]
  sessions     UserSession[]
  auditLogs    PlatformAuditLog[]
  ventas       Venta[]
  cotizaciones Cotizacion[]
  anotaciones  Anotacion[]
}

model TenantMembership {
  id            String       @id @default(uuid())
  tenantId      String
  userId        String
  role          RolMembresia @default(VENDEDOR)
  commissionPct Float?       @default(0)
  locationId    String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum RolMembresia {
  OWNER
  MANAGER
  VENDEDOR
  ADMINISTRATIVO
  TALLER
}

// ==========================================
// 3. SUCURSALES
// ==========================================

model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  vehiculos   Vehiculo[]
  ventas      Venta[]
  tareas      Tarea[]
  gastos      Gasto[]
  cashSessions CashSession[]
  cashMovements CashMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// ==========================================
// 4. CLIENTES
// ==========================================

model Cliente {
  id_cliente      Int      @id @default(autoincrement())
  tenantId        String
  nombre_completo String
  dni_cuit        String?
  telefono        String?
  email           String?
  direccion       String?
  localidad       String?
  fecha_nacimiento DateTime?
  ocupacion       String?
  notas           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehiculos   Vehiculo[]
  ventas      Venta[]
  prestamos   Prestamo[]
  prospectos  Prospecto[]

  @@index([tenantId, nombre_completo])
  @@index([tenantId, dni_cuit])
}

// ==========================================
// 5. VEHICULOS
// ==========================================

model Vehiculo {
  id_vehiculo             Int       @id @default(autoincrement())
  tenantId                String
  locationId              String?
  id_cliente              Int?
  marca                    String
  modelo                   String
  version                  String?
  anio                     Int
  patente                  String?
  chasis                   String?
  motor                    String?
  kilometraje              Int?      @default(0)
  combustible              String?
  transmision              String?
  color                    String?
  tipo                     String    @default("AUTO")
  estado                   String    @default("EN_PREPARACION")
  condicion                String    @default("PROPIO")
  fecha_ingreso            DateTime  @default(now())
  precio_compra_usd        Decimal?  @db.Decimal(10, 2)
  precio_compra_ars        Decimal?  @db.Decimal(12, 2)
  precio_venta_usd         Decimal?  @db.Decimal(10, 2)
  precio_venta_ars         Decimal?  @db.Decimal(12, 2)
  gastos_preparacion_usd   Decimal?  @default(0) @db.Decimal(10, 2)
  gastos_gestoria_usd      Decimal?  @default(0) @db.Decimal(10, 2)
  costo_total_real_usd     Decimal?  @default(0) @db.Decimal(10, 2)
  precio_minimo_usd        Decimal?  @db.Decimal(10, 2)
  comision_consignacion_pct Float?   @default(0)
  fecha_publicacion        DateTime?
  notas_internas           String?   @db.Text
  permuta_de_venta_id      Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  cliente     Cliente?      @relation(fields: [id_cliente], references: [id_cliente], onDelete: SetNull)
  fotos       VehiculoFoto[]
  tareas      Tarea[]
  gastos      Gasto[]
  ventas      Venta[]
  senias      Senia[]
  prospectos  Prospecto[]
  cotizaciones Cotizacion[]

  @@index([tenantId, estado])
  @@index([tenantId, patente])
  @@index([tenantId, tipo])
  @@index([locationId])
}

model VehiculoFoto {
  id_foto     Int      @id @default(autoincrement())
  tenantId    String
  id_vehiculo Int
  url         String
  key         String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehiculo Vehiculo @relation(fields: [id_vehiculo], references: [id_vehiculo], onDelete: Cascade)

  @@index([tenantId, id_vehiculo])
}

// ==========================================
// 6. TALLER / TAREAS / GASTOS
// ==========================================

model Tarea {
  id_tarea      Int       @id @default(autoincrement())
  tenantId      String
  locationId    String?
  id_vehiculo   Int
  descripcion   String
  estado_tarea  String    @default("PENDIENTE")
  prioridad     String    @default("NORMAL")
  fecha_creacion DateTime @default(now())
  fecha_limite   DateTime?
  fecha_finalizada DateTime?
  costo_estimado_usd Decimal? @default(0) @db.Decimal(10, 2)
  costo_real_usd     Decimal? @default(0) @db.Decimal(10, 2)
  responsable       String?
  notas             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vehiculo Vehiculo   @relation(fields: [id_vehiculo], references: [id_vehiculo], onDelete: Cascade)
  gastos   Gasto[]

  @@index([tenantId, estado_tarea])
  @@index([id_vehiculo])
}

model Gasto {
  id_gasto        Int       @id @default(autoincrement())
  tenantId        String
  locationId      String?
  id_tarea        Int?
  id_vehiculo     Int?
  descripcion     String
  categoria       String?
  tipo_movimiento String    @default("EGRESO")
  monto_usd       Decimal?  @default(0) @db.Decimal(12, 2)
  monto_ars       Decimal?  @default(0) @db.Decimal(14, 2)
  fecha           DateTime  @default(now())
  comprobante     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tarea    Tarea?     @relation(fields: [id_tarea], references: [id_tarea], onDelete: SetNull)
  vehiculo Vehiculo?  @relation(fields: [id_vehiculo], references: [id_vehiculo], onDelete: SetNull)

  @@index([tenantId, fecha])
  @@index([id_vehiculo])
}

// ==========================================
// 7. VENTAS Y FINANCIACION
// ==========================================

model Venta {
  id_venta               Int       @id @default(autoincrement())
  tenantId               String
  locationId             String?
  id_vehiculo            Int
  id_cliente             Int
  vendedorId             String?
  numero_boleto          String?
  fecha_venta             DateTime  @default(now())
  precio_final_usd        Decimal   @db.Decimal(12, 2)
  precio_final_ars        Decimal?  @db.Decimal(14, 2)
  cotizacion_dolar_venta Decimal?  @db.Decimal(10, 2)
  forma_pago              String    @default("CONTADO")
  anticipo_usd            Decimal?  @default(0) @db.Decimal(12, 2)
  anticipo_ars            Decimal?  @default(0) @db.Decimal(14, 2)
  saldo_financiado_usd    Decimal?  @default(0) @db.Decimal(12, 2)
  cantidad_cuotas         Int?      @default(0)
  tna_aplicada            Float?    @default(0)
  permuta_descripcion     String?
  permuta_valor_usd       Decimal?  @default(0) @db.Decimal(12, 2)
  observaciones           String?   @db.Text
  estado                  String    @default("CONFIRMADA")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vehiculo    Vehiculo      @relation(fields: [id_vehiculo], references: [id_vehiculo])
  cliente     Cliente       @relation(fields: [id_cliente], references: [id_cliente])
  vendedor    User?         @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  cuotas      VentaCuota[]
  entrega     Entrega?
  prospecto   Prospecto?    @relation(fields: [prospectoId], references: [id_prospecto], onDelete: SetNull)
  prospectoId Int?

  @@index([tenantId, fecha_venta])
  @@index([id_vehiculo])
  @@index([id_cliente])
}

model VentaCuota {
  id_cuota         Int       @id @default(autoincrement())
  tenantId         String
  id_venta         Int
  numero_cuota     Int
  monto_usd        Decimal   @db.Decimal(12, 2)
  monto_ars        Decimal?  @db.Decimal(14, 2)
  cotizacion_pago  Decimal?  @db.Decimal(10, 2)
  fecha_vencimiento DateTime
  fecha_pago       DateTime?
  estado           String    @default("PENDIENTE")
  metodo_pago      String?
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venta  Venta  @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)

  @@index([tenantId, estado])
  @@index([id_venta, numero_cuota])
}

model Prestamo {
  id_prestamo       Int       @id @default(autoincrement())
  tenantId          String
  id_cliente        Int
  monto_original_usd Decimal  @db.Decimal(12, 2)
  saldo_pendiente_usd Decimal @db.Decimal(12, 2)
  tasa_anual        Float     @default(0)
  cantidad_cuotas   Int
  fecha_inicio      DateTime  @default(now())
  estado            String    @default("ACTIVO")
  notas             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente Cliente        @relation(fields: [id_cliente], references: [id_cliente])
  cuotas  PrestamoCuota[]

  @@index([tenantId, estado])
}

model PrestamoCuota {
  id_cuota          Int       @id @default(autoincrement())
  tenantId          String
  id_prestamo       Int
  numero_cuota      Int
  capital_usd       Decimal   @db.Decimal(12, 2)
  interes_usd       Decimal   @db.Decimal(12, 2)
  monto_total_usd   Decimal   @db.Decimal(12, 2)
  fecha_vencimiento DateTime
  fecha_pago        DateTime?
  estado            String    @default("PENDIENTE")
  observaciones     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prestamo Prestamo @relation(fields: [id_prestamo], references: [id_prestamo], onDelete: Cascade)

  @@index([tenantId, estado])
  @@index([id_prestamo, numero_cuota])
}

// ==========================================
// 8. CRM / SEÑAS / COTIZACIONES / ENTREGAS
// ==========================================

enum EstadoProspecto {
  NUEVO
  CONTACTADO
  NEGOCIACION
  SENADO
  VENDIDO
  PERDIDO
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

model Prospecto {
  id_prospecto              Int              @id @default(autoincrement())
  tenantId                  String
  id_cliente                Int?
  nombre                    String
  telefono                  String?
  email                     String?
  id_vehiculo_interes       Int?
  vendedorId                String?
  origen                    String?          @default("SHOWROOM")
  estado                    EstadoProspecto  @default(NUEVO)
  presupuesto_estimado_usd  Decimal?         @db.Decimal(12, 2)
  tiene_permuta             Boolean          @default(false)
  detalle_permuta           String?          @db.Text
  notas                     String?          @db.Text
  fecha_contacto            DateTime         @default(now())
  proxima_accion            DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente            Cliente?       @relation(fields: [id_cliente], references: [id_cliente], onDelete: SetNull)
  vehiculo_interes   Vehiculo?      @relation(fields: [id_vehiculo_interes], references: [id_vehiculo], onDelete: SetNull)
  vendedor           User?          @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  cotizaciones       Cotizacion[]
  senias             Senia[]
  ventas             Venta[]

  @@index([tenantId, estado])
  @@index([vendedorId])
}

model Cotizacion {
  id_cotizacion          Int               @id @default(autoincrement())
  tenantId               String
  id_prospecto           Int?
  id_vehiculo            Int
  vendedorId             String?
  precio_lista_usd       Decimal           @db.Decimal(12, 2)
  descuento_usd          Decimal           @default(0) @db.Decimal(12, 2)
  precio_final_usd       Decimal           @db.Decimal(12, 2)
  cotizacion_dolar       Decimal           @db.Decimal(10, 2)
  precio_final_ars       Decimal           @db.Decimal(14, 2)
  anticipo_usd           Decimal           @default(0) @db.Decimal(12, 2)
  cantidad_cuotas        Int               @default(0)
  tna_aplicada           Float             @default(0)
  valor_cuota_usd        Decimal?          @db.Decimal(12, 2)
  permuta_descripcion    String?           @db.Text
  permuta_valor_usd      Decimal           @default(0) @db.Decimal(12, 2)
  validez_hasta          DateTime?
  estado                 EstadoCotizacion  @default(BORRADOR)
  observaciones          String?           @db.Text
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospecto    Prospecto?  @relation(fields: [id_prospecto], references: [id_prospecto], onDelete: SetNull)
  vehiculo     Vehiculo    @relation(fields: [id_vehiculo], references: [id_vehiculo])
  vendedor     User?       @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([id_prospecto])
}

model Senia {
  id_senia         Int       @id @default(autoincrement())
  tenantId         String
  id_vehiculo      Int
  id_cliente       Int?
  id_prospecto     Int?
  monto_usd        Decimal?  @db.Decimal(12, 2)
  monto_ars        Decimal?  @db.Decimal(14, 2)
  cotizacion       Decimal?  @db.Decimal(10, 2)
  fecha_senia      DateTime  @default(now())
  vence_en         DateTime?
  estado           String    @default("ACTIVA")
  metodo_pago      String?
  observaciones    String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehiculo   Vehiculo    @relation(fields: [id_vehiculo], references: [id_vehiculo])
  prospecto  Prospecto?  @relation(fields: [id_prospecto], references: [id_prospecto], onDelete: SetNull)

  @@index([tenantId, estado])
  @@index([id_vehiculo])
}

model Entrega {
  id_entrega       Int       @id @default(autoincrement())
  tenantId         String
  id_venta         Int       @unique
  fecha_programada DateTime?
  fecha_entrega    DateTime?
  estado           String    @default("PENDIENTE")
  documentacion_ok Boolean   @default(false)
  unidad_ok        Boolean   @default(false)
  pago_ok          Boolean   @default(false)
  observaciones    String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venta  Venta  @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)

  @@index([tenantId, estado])
}

// ==========================================
// 9. CAJA OPERATIVA
// ==========================================

model CashSession {
  id          String    @id @default(uuid())
  tenantId    String
  locationId  String?
  openedById  String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingArs  Decimal   @default(0) @db.Decimal(14, 2)
  closingArs  Decimal?  @db.Decimal(14, 2)
  status      String    @default("OPEN")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  movements CashMovement[]

  @@index([tenantId, status])
}

model CashMovement {
  id          String    @id @default(uuid())
  tenantId    String
  locationId  String?
  sessionId   String?
  type        String
  category    String
  concept     String
  amountArs   Decimal   @db.Decimal(14, 2)
  amountUsd   Decimal?  @db.Decimal(12, 2)
  exchangeRate Decimal? @db.Decimal(10, 2)
  reference   String?
  createdAt   DateTime  @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  session  CashSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([sessionId])
}
