# ==========================================
# OnlyCars SaaS - Entorno de Producción NanoLabs
# ==========================================

# Base de Datos MariaDB 11.8 (Interna en contenedor)
DB_NAME=onlycars
DB_USER=onlycars
DB_PASSWORD=generar_password_seguro_db
DB_ROOT_PASSWORD=generar_password_root_seguro

# URL de conexión interna para la app
DATABASE_URL=mysql://onlycars:generar_password_seguro_db@db:3306/onlycars

# Dominios y Plataforma
BASE_DOMAIN=onlycars.nanoapps.ar
BASE_URL=https://onlycars.nanoapps.ar

# Configuración Regional
TZ=America/Argentina/Buenos_Aires
NODE_ENV=production
