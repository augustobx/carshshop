# ==========================================
# OnlyCars SaaS - Entorno de Producción NanoLabs
# ==========================================

# Base de Datos MariaDB 11.8 (Interna en contenedor)
DB_NAME=onlycars
DB_USER=onlycars
DB_PASSWORD=generar_password_seguro_db
DB_ROOT_PASSWORD=generar_password_root_seguro

# URL de conexión interna para la app
DATABASE_URL=mysql://onlycars:generar_password_seguro_db@db:3306/onlycars

# Dominios
# Plataforma/SuperAdmin: https://onlycars.nanoapps.ar
# Tenants: https://<slug>.nanoapps.ar
PLATFORM_HOST=onlycars.nanoapps.ar
TENANT_BASE_DOMAIN=nanoapps.ar
BASE_URL=https://onlycars.nanoapps.ar

# Cloudflare R2 - fotos de vehículos
# Puede utilizar el mismo bucket/CDN de NanoLabs que OnlyFood; OnlyCars queda aislado
# bajo onlycars/tenants/<tenantId>/...
STORAGE_PROVIDER=r2
STORAGE_PREFIX=onlycars
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=<BUCKET>
R2_ACCESS_KEY_ID=<ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
R2_PUBLIC_URL=https://<CDN_PUBLICO>

# Bootstrap de usuarios de acceso
# Estas variables se usan únicamente al ejecutar el perfil migration/database-init.
SEED_SUPERADMIN_EMAIL=desa@nanolabs.com.ar
SEED_SUPERADMIN_PASSWORD=definir_password_superadmin
SEED_DEMO_ADMIN_EMAIL=admin@carshop.com
SEED_DEMO_ADMIN_PASSWORD=definir_password_demo

# Configuración Regional
TZ=America/Argentina/Buenos_Aires
NODE_ENV=production
